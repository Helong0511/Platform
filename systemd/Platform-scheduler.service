[Unit]
Description=Platform Backend Scheduler (single worker, scheduled tasks only)
After=network.target mysql.service redis.service Platform-backend.service
Wants=mysql.service redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/data/Platform
Environment="PATH=/data/Platform/venv/bin"
EnvironmentFile=/data/Platform/.env
# 以下变量必须写在 EnvironmentFile 之后，覆盖 .env 中的 ENABLE_SCHEDULER=false
Environment="PRODUCTION_ENV=production"
Environment="GUNICORN_ROLE=scheduler"
Environment="ENABLE_SCHEDULER=true"
Environment="SCHEDULER_WORKER=1"
Environment="WORKERS=1"

ExecStartPre=/bin/mkdir -p /data/Platform/logs
ExecStartPre=/bin/chown -R www-data:www-data /data/Platform/logs
# 预创建常用日志（默认不创建 gunicorn_scheduler_access.log）
ExecStartPre=/bin/touch /data/Platform/logs/gunicorn_scheduler.pid /data/Platform/logs/gunicorn_scheduler_error.log /data/Platform/logs/error.log /data/Platform/logs/warning.log /data/Platform/logs/app.log /data/Platform/logs/scheduler.log
ExecStartPre=/bin/chown www-data:www-data /data/Platform/logs/gunicorn_scheduler.pid /data/Platform/logs/gunicorn_scheduler_error.log /data/Platform/logs/error.log /data/Platform/logs/warning.log /data/Platform/logs/app.log /data/Platform/logs/scheduler.log
ExecStartPre=/bin/chmod 644 /data/Platform/logs/gunicorn_scheduler.pid /data/Platform/logs/gunicorn_scheduler_error.log /data/Platform/logs/error.log /data/Platform/logs/warning.log /data/Platform/logs/app.log /data/Platform/logs/scheduler.log

# 使用独立 pid/日志（gunicorn.conf.py 根据 GUNICORN_ROLE=scheduler 切换）
ExecStart=/data/Platform/venv/bin/gunicorn \
    --config /data/Platform/gunicorn.conf.py \
    app.main:app

Restart=always
RestartSec=10
# 须大于 gunicorn.conf.py graceful_timeout(30)，确保停服时 cron 不再触发
TimeoutStopSec=45
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=platform-scheduler

[Install]
WantedBy=multi-user.target
