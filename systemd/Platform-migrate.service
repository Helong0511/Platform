[Unit]
Description=Platform Database Migration Runner (one-shot, fail-closed)
After=network.target mysql.service
Wants=mysql.service
# API 与 Scheduler 通过 Requires/After 依赖本服务；本服务失败时禁止业务 Worker 启动。

[Service]
Type=oneshot
User=platform-migrator
Group=platform-migrator
WorkingDirectory=/run/platform-migration
RuntimeDirectory=platform-migration
RuntimeDirectoryMode=0700
# systemd LoadCredential 将 root 管理的 DSN 文件放入服务专属只读凭据目录。
LoadCredential=application-database-url:/etc/platform/migration-app-database-url
LoadCredential=migration-database-url:/etc/platform/migration-database-url
Environment=PATH=/data/Platform/venv/bin
Environment=PYTHONPATH=/data/Platform
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1

# validate 离线检查；apply 执行增量 DDL；status 在 apply 后再次核验 ledger。
ExecStartPre=/data/Platform/venv/bin/python -m app.db.migrations validate
ExecStart=/data/Platform/venv/bin/python -m app.db.migrations apply
ExecStartPost=/data/Platform/venv/bin/python -m app.db.migrations status

# 生产大表 DDL 可能较长；超时失败后必须人工核验 running/failed ledger，不得盲目重跑。
TimeoutStartSec=2h
TimeoutStopSec=30s
Restart=no
RemainAfterExit=yes
KillMode=control-group
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/data/Platform
ReadWritePaths=/run/platform-migration

StandardOutput=journal
StandardError=journal
SyslogIdentifier=platform-migrate

[Install]
# 不单独 enable；由 backend/scheduler 的 Requires 关系按需触发。
