# 安全环境变量模板
# 复制为 .env（仅在服务器/本地，不要提交真实 .env），再填入环境专属值。
# 所有密码、Token、API Key 必须通过部署密钥管理注入，不得写入 Git。

PRODUCTION_ENV=development
ENV_NAME=development

# 必须显式设置；不再提供源码内置数据库账号或密码。
DATABASE_URL=mysql+aiomysql://<db_user>:<url_encoded_password>@127.0.0.1:3306/platform?charset=utf8mb4&collation=utf8mb4_0900_ai_ci

# 必须使用独立随机值；生产环境请使用密钥管理服务注入。
SECRET_KEY=<generate-a-unique-random-secret>
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=<generate-a-unique-strong-password>

# Redis；生产环境请设置独立密码并限制网络访问。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# 生产环境必须明确设置允许的前端来源。
BACKEND_CORS_ORIGINS=[]
DEBUG=false
ENABLE_CSRF=true
# RS256 生产环境密钥必须由密钥管理服务注入，或使用仓库外绝对路径。
# RSA_PRIVATE_KEY_PATH=/var/lib/platform/keys/private_key.pem
# RSA_PUBLIC_KEY_PATH=/var/lib/platform/keys/public_key.pem

# GAM 服务账号 JSON 必须存放在仓库外；生产环境必须配置绝对路径（目录 0700、文件 0600）。
# GAM_SECRETS_DIR=/var/lib/platform/gam-secrets
