# ==============================================================================
# 生产环境配置文件模板
# ==============================================================================
# 使用说明：
# 1. 复制此文件为 .env：cp env.example .env
# 1. 复制此文件为 .env：mv /data/Platform/env.example /data/Platform/.env

# 1. 将 .env 文件的所有者设置为 www-data
# sudo chown www-data:www-data /data/Platform/.env
# 2. 设置文件权限为 640（所有者可读写，组可读）
# sudo chmod 640 /data/Platform/.env

# 2. 根据实际情况修改所有配置项的值
# 3. 生产环境必须设置所有标记为 [必填] 的配置项
# 4. 确保 .env 文件权限安全：chmod 600 .env
# ==============================================================================

# ==============================================================================
# 一、环境配置
# ==============================================================================
# [必填] 环境类型：production/prod 为生产环境，其他为开发环境
# 生产环境必须设置为 "production" 或 "prod"
PRODUCTION_ENV=production

# ==============================================================================
# 二、安全配置
# ==============================================================================
# [必填] JWT签名密钥，用于生成和验证访问令牌
# 生产环境必须设置，长度至少32个字符，建议使用64字符以上的随机字符串
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=NeofZ7iF8tNW6GzkyMZfsGmitY6r6Gwn6D5BU433Vu9lkFwciS2PApBkPMurQuexc9ZgWUjxQA6ZBHMx_bdvHQ

# ==============================================================================
# 三、JWT配置
# ==============================================================================
# JWT 算法配置
# 可选值：RS256（推荐，非对称加密）或 HS256（对称加密）
# 默认值：RS256
# 说明：
#   - RS256：更安全，使用 RSA 公钥/私钥对，推荐用于生产环境
#   - HS256：配置简单，使用 SECRET_KEY，适合开发环境
# 详细配置说明请参考：docs/JWT配置指南.md
JWT_ALGORITHM=RS256

# 访问令牌过期时间（分钟）
# 默认：240分钟（4小时）
# 建议值：
#   - 开发环境：60-120分钟
#   - 生产环境：60-240分钟（根据安全需求调整）
#   - 高安全要求：30-60分钟
ACCESS_TOKEN_EXPIRE_MINUTES=240

# RSA 密钥配置（仅 RS256 算法需要）
# 方法1：使用文件路径（推荐用于服务器部署）
# 生产环境（Ubuntu）使用绝对路径：
# RSA_PRIVATE_KEY_PATH=/data/Platform/keys/private_key.pem
# RSA_PUBLIC_KEY_PATH=/data/Platform/keys/public_key.pem
# 测试环境（Windows）可以使用相对路径：
# RSA_PRIVATE_KEY_PATH=keys/private_key.pem
# RSA_PUBLIC_KEY_PATH=keys/public_key.pem
#
# 方法2：使用环境变量（适合容器部署）
# 注意：私钥内容需要包含完整的 PEM 格式，包括换行符
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
#
# 生成密钥对：
#   - 使用脚本：python scripts/generate_rsa_keys.py --output-dir keys
#   - 使用 OpenSSL：openssl genrsa -out private_key.pem 2048 && openssl rsa -in private_key.pem -pubout -out public_key.pem
# 详细说明请参考：docs/JWT配置指南.md
RSA_PRIVATE_KEY_PATH=/data/Platform/keys/private_key.pem
RSA_PUBLIC_KEY_PATH=/data/Platform/keys/public_key.pem

# ==============================================================================
# 四、数据库配置
# ==============================================================================
# [必填] 数据库连接URI
# 格式：mysql+aiomysql://用户名:密码@主机:端口/数据库名
# Ubuntu推荐使用 127.0.0.1（更可靠，避免IPv6解析问题）
# 示例：mysql+aiomysql://root:your_password@127.0.0.1:3306/platform
# 生产环境必须设置，且不能使用默认密码
DATABASE_URL=mysql+aiomysql://remote:kb7$rL3d8!tQ@127.0.0.1:3306/platform

# 数据库连接池大小（每个 worker 进程）
# 默认：15
# 建议值：10-20（根据数据库服务器性能调整）
# 总连接数 = (DB_POOL_SIZE + DB_MAX_OVERFLOW) × Worker数量
DB_POOL_SIZE=15

# 数据库连接池最大溢出连接数（每个 worker 进程）
# 默认：10
# 建议值：5-15
DB_MAX_OVERFLOW=10

# 数据库连接回收时间（秒）
# 默认：3600（1小时）
# 建议值：3600-7200
DB_POOL_RECYCLE=3600

# ==============================================================================
# 五、Redis配置
# ==============================================================================
# Redis连接URL（用于缓存、限流、CSRF令牌存储等）
# 注意：代码实际使用 REDIS_HOST，此配置仅供参考
# 格式：redis://[密码@]主机:端口/数据库编号
# 示例：redis://127.0.0.1:6379/0
# 如果Redis设置了密码：redis://:your_password@127.0.0.1:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0

# Redis主机地址（Ubuntu推荐使用 127.0.0.1，更可靠）
# 如果未配置，将使用内存存储（多进程环境下可能不一致）
REDIS_HOST=127.0.0.1

# Redis端口（可选，如果使用REDIS_URL可以省略）
# REDIS_PORT=6379

# Redis数据库编号（可选，如果使用REDIS_URL可以省略）
# REDIS_DB=0

# Redis密码（如果Redis设置了密码）
# REDIS_PASSWORD=

# Redis最大连接数
# 默认：10
REDIS_MAX_CONNECTIONS=10

# ==============================================================================
# 六、CORS配置
# ==============================================================================
# [必填] 允许的跨域来源（多个域名用逗号分隔）
# 生产环境必须设置，且不能包含 localhost 或 127.0.0.1
# 所有域名必须使用 HTTPS（生产环境）
# 示例：https://btfrx.online,https://www.btfrx.online,https://client.btfrx.online
BACKEND_CORS_ORIGINS=https://btfrx.online,https://www.btfrx.online,https://client.btfrx.online

# ==============================================================================
# 七、管理员账户配置
# ==============================================================================
# [必填] 首次启动时创建的管理员用户名
# 默认：admin
FIRST_SUPERUSER=admin

# [必填] 首次启动时创建的管理员密码
# 生产环境必须设置，长度至少12个字符，且不能使用默认密码 "admin123"
# 建议使用强密码：包含大小写字母、数字、特殊字符
FIRST_SUPERUSER_PASSWORD=My@SecurePssw0rd2025!

# ==============================================================================
# 八、API限流配置
# ==============================================================================
# 默认API限流：每分钟请求数
# 默认：100
# 建议值：根据服务器性能和业务需求调整（50-200）
API_RATE_LIMIT=100

# 登录接口限流：每分钟请求数（防止暴力破解）
# 默认：5
# 建议值：3-10（根据安全需求调整）
LOGIN_RATE_LIMIT=10

# ==============================================================================
# 九、文件上传配置
# ==============================================================================
# 最大文件上传大小（字节）
# 默认：10485760（10MB）
# 建议值：根据业务需求调整（10MB-100MB）
MAX_UPLOAD_SIZE=10485760

# ==============================================================================
# 十、CSRF防护配置
# ==============================================================================
# 是否启用CSRF防护
# 默认：true（启用）
# 生产环境建议启用
ENABLE_CSRF=true

# CSRF令牌过期时间（秒）
# 默认：3600（1小时）
# 建议值：1800-7200
CSRF_TOKEN_EXPIRE_SECONDS=3600

# ==============================================================================
# 十一、定时任务配置
# ==============================================================================
# 最大并发定时任务数（同一进程同时执行的任务数量）
# 默认：2
# 建议值：
#   - 1：严格顺序执行，适合资源紧张或任务相互依赖的场景
#   - 2-3：推荐值，充分利用进程资源，适合大多数场景
#   - 4+：仅当任务执行时间很短且系统资源充足时使用
MAX_CONCURRENT_SCHEDULED_TASKS=2

# ==============================================================================
# 十二、日志配置
# ==============================================================================
# 日志级别
# 可选值：DEBUG, INFO, WARNING, ERROR, CRITICAL
# 默认：INFO
# 生产环境建议：WARNING 或 INFO
LOG_LEVEL=INFO

# 日志文件路径
# 默认：logs/app.log
LOG_FILE=logs/app.log

# 日志文件最大大小（字节）
# 默认：10485760（10MB）
# 建议值：10MB-50MB
LOG_MAX_BYTES=10485760

# 日志文件备份数量
# 默认：5
# 建议值：5-10
LOG_BACKUP_COUNT=5

# ==============================================================================
# 十三、审计日志配置
# ==============================================================================
# 审计日志保留天数（超过此天数的日志将被清理）
# 默认：90（3个月）
# 建议值：
#   - 30-60 天：适合高频操作场景，节省存储空间
#   - 90-180 天：推荐值，平衡存储和查询需求
#   - 180+ 天：适合需要长期审计的场景
AUDIT_LOG_RETENTION_DAYS=30

# 是否归档旧日志（True：归档到归档表，False：直接删除）
# 默认：false（直接删除）
# 如果需要保留历史日志，可以设置为 true 并创建归档表
AUDIT_LOG_ARCHIVE=true

# ==============================================================================
# 十四、时区配置
# ==============================================================================
# 应用时区（用于调度器、前端显示等）
# 默认：Asia/Shanghai（中国时区，UTC+8）
# 可选值：Asia/Shanghai, UTC, America/New_York 等（pytz 支持的时区）
TIMEZONE=Asia/Shanghai

# ==============================================================================
# 十五、Telegram Bot配置
# ==============================================================================
# 是否启用 Telegram Bot 功能
# 默认：true（启用）
# 设置为 false/0/no 可禁用 Telegram 功能
TELEGRAM_ENABLE=true

# Telegram Bot Token（从 BotFather 获取）
# 如果启用了 Telegram Bot，此配置为必填
# 获取方式：
#   1. 在 Telegram 中搜索 @BotFather
#   2. 发送 /newbot 命令创建新机器人
#   3. 按照提示设置机器人名称和用户名
#   4. 获取 Token 并设置到此配置项
# Platform_Stat_Bot
TELEGRAM_TOKEN=8348688058:AAE0CXsgR4iNjzvcPjHOICQp8e3WSKJ5OtQ

# Test_Stat_Bot
# TELEGRAM_TOKEN=8263751942:AAH5rvEopgKEERvUa9peWZ-TnctU230rHUU

# Telegram 管理员 Chat ID（用于接收系统通知）
# 可以是用户 ID（如 "123456789"）或群组 ID（如 "-1001234567890"）
# 获取方式：
#   1. 向 Bot 发送 /id 命令（如果已实现）
#   2. 使用 @userinfobot 查询自己的用户ID
#   3. 在群组中添加 Bot，然后查询群组ID
TELEGRAM_ADMIN=5312177749

# ==============================================================================
# 十六、Gunicorn配置（可选）
# ==============================================================================
# Worker 数量（可选，如果不设置会根据CPU核心数自动计算）
# 推荐公式：workers = (2 × CPU核心数) + 1
# 可以通过此环境变量覆盖自动计算的值
WORKERS=3

# 是否启用应用预加载（可选）
# 默认：false（关闭，节省内存）
# 如果服务器内存充足（>= 8GB），可以设置为 true 提升性能
PRELOAD_APP=false

# 服务器内存大小（GB，可选）
# 用于自动优化 Worker 数量（小内存服务器会减少 Worker 数量）
MEMORY_GB=4

# ==============================================================================
# 配置说明
# ==============================================================================
# 1. 所有标记为 [必填] 的配置项在生产环境必须设置
# 2. 密码和密钥等敏感信息请使用强密码，不要使用默认值
# 3. 生产环境建议定期更换 SECRET_KEY 和数据库密码
# 4. 确保 .env 文件权限安全：chmod 600 .env
# 5. 不要将 .env 文件提交到版本控制系统（Git）
# 6. 建议使用环境变量管理工具（如 vault、secrets manager）管理敏感配置
# ==============================================================================

