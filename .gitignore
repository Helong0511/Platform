# ============================================
# Git 忽略文件配置
# 创建时间：2026-01-14
# ============================================

# ============================================
# Python 相关文件
# ============================================
# Python 字节码缓存文件
__pycache__/
*.py[cod]
*$py.class

# Python 编译文件
*.so

# Python 环境标识
.Python

# Python 构建和分发目录
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============================================
# 虚拟环境
# ============================================
# Python 虚拟环境目录
venv/
ENV/
env/
.venv

# ============================================
# 测试相关文件
# ============================================
tests/**/__pycache__/
tests/**/*.pyc
tests/_patch_*.py
tests/manual/
.pytest_cache/
.tox/
.nox/

sc.bat
# ============================================
# IDE 和编辑器配置文件
# ============================================
# Visual Studio Code
.vscode/

# PyCharm / IntelliJ IDEA
.idea/

# Vim / Emacs 临时文件
*.swp
*.swo
*~

# Cursor IDE
.cursor

# ============================================
# 环境变量文件
# ============================================
.env.*
!.env.example

# ============================================
# 日志文件
# ============================================
# 日志目录和文件
logs/
*.log

# 项目特定日志目录
scripts/错误日志/

# ============================================
# 数据库文件
# ============================================
# SQLite 数据库文件
*.db
*.sqlite
*.sqlite3

# 数据库备份和 SQL 脚本（可能包含敏感数据）
# 注意：如果 SQL 文件是迁移脚本，可能需要保留
# scripts/data/*.sql
# scripts/migrations/*.sql

# ============================================
# 操作系统生成的文件
# ============================================
# macOS
.DS_Store

# Windows
Thumbs.db

# ============================================
# 机器学习模型文件（大文件）
# ============================================
# 模型文件通常很大，建议使用 Git LFS 或单独存储
models/*.pkl
models/*.h5
models/*.pt

# ============================================
# 临时文件和缓存
# ============================================
# 临时目录
tmp/
temp/
*.tmp

# 备份文件
*.bak
*.backup
*~

# 缓存目录
.cache

# ============================================
# 测试覆盖率报告
# ============================================
# 代码覆盖率报告
htmlcov/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover

# pytest 缓存
.pytest_cache/
.pytest_cache

# ============================================
# 类型检查工具
# ============================================
# mypy 类型检查器缓存
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre 类型检查器
.pyre/

# ============================================
# 前端相关文件
# ============================================
# Node.js 依赖包
node_modules/
frontend/node_modules/

# 前端构建产物
dist/
dist-ssr/
frontend/dist/
*.local

# npm/yarn/pnpm 锁定文件（frontend 需提交 lock 以保证服务器可重复安装）
package-lock.json
yarn.lock
pnpm-lock.yaml
!frontend/package-lock.json

# Vite 构建缓存
.vite/
frontend/.vite/

# 前端公共文件目录（包含构建生成的文件）
frontend/public/

# ============================================
# Docker 相关
# ============================================
# Docker 忽略文件（如果不需要版本控制）
.dockerignore

# ============================================
# 密钥和证书文件（安全敏感）
# ============================================
# 密钥文件
*.crt
*.cert
*.p12
*.pfx

# 密钥目录
scripts/keys/

# ============================================
# 数据文件（可能包含敏感信息）
# ============================================
# Excel 文件（可能包含业务数据）
*.xlsx
*.xls
*.xlsm

# CSV 文件（如果包含敏感数据，取消注释）
# *.csv

# ============================================
# 压缩文件（通常是临时或备份）
# ============================================
# 压缩包文件
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ============================================
# 项目特定文件
# ============================================
# 导入样本目录
导入样本/
.trae
# 默认忽略 tests 下内容；仅白名单本仓库集成测试脚本
tests/*
!tests/test_*.py
!tests/scan_route_order.py
dump.rdb
