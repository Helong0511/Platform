ZHISUO_API_ACCOUNT_FETCH={"KE11":{"fetch_unit":false,"fetch_country":false,"fetch_data":true,"fetch_daily_fallback":false},"zhisuo252":{"fetch_unit":false,"fetch_country":false,"fetch_data":true,"fetch_daily_fallback":false}}

POMIAD_API_BASE_URL=https://data.pomiad.com/ys_data
POMIAD_API_USERNAME=Yic
POMIAD_API_PASSWORD=Yic12356
POMIAD_IS_BY_COUNTRY=1
POMIAD_API_DATA_LIMIT=1000

# ---------- H5 Deer 上游广告 API（定时任务：H5 Deer API获取数据）----------
# 开放 API 根地址（无尾斜杠）。文档要求 HTTP + 端口 8000；
# 登录拼 /api/user_oauth/token，报表拼 /v1/api/h5report。勿写成 www.h5deer.com 网页地址。
H5DEER_API_BASE_URL=http://api.h5deer.com:8000

# 开放 API 登录用户名 / 密码（POST JSON 换 JWT；Header 为「JWT <token>」，非 Bearer）
H5DEER_API_USERNAME=HYCQ06701
H5DEER_API_PASSWORD=HYCQ06701abcd

# 报表聚合维度（逗号分隔）。可选：date,url,country_code,ad_nuit
# 默认最细颗粒度：日期+URL+国家+广告单元
# 注意：dimension 参数拼写为 ad_nuit；响应 JSON 字段为 adNuit
H5DEER_API_DIMENSION=date,url,country_code,ad_nuit

# 每页条数，最大 500（对接文档上限）
H5DEER_API_LIMIT=500

# ---------- Aya / AB Data 上游广告 API（定时任务：Aya API获取数据）----------
# 开放 API 根地址（无尾斜杠）；请求为 POST form-urlencoded，非 JSON Body
AYA_API_BASE_URL=https://dashboard.abdatas.com/prod-api

# secretKey（对接文档参数名）
AYA_API_SECRET_KEY=dc5867c73d315fd0fb9624716c047ffb

# 拉数维度开关：日报 getDay | 国家 getAdsDataCountry | 广告单元 getAdsDataUnit
AYA_API_FETCH_DAILY=false
AYA_API_FETCH_COUNTRY=true
AYA_API_FETCH_UNIT=false

# ========== FlyMobi（ads.gofinds.xyz）==========
FLYMOBI_API_BASE_URL=https://ads.gofinds.xyz/prod-api
FLYMOBI_API_TOKEN=MIIBVAIBADANBgkqhkiG9w0BAQEFAASCAT4wggE6AgEAAkEAjBigOFKEMVSPrdPvUZi_QBqG33GBuDpIcFDPL9wOysERLCX9dc57b71d-f34a-3cab-8bbc-25c436a16a64cbeaa7d9-9e81-4c4d-a5f6-d0e9f139d76c

# 拉数维度开关：countryList | adUnitList | dayList
FLYMOBI_API_FETCH_COUNTRY=true
FLYMOBI_API_FETCH_UNIT=false
FLYMOBI_API_FETCH_DAILY=false

# ==============================================================================
# 二十一、敏感路径防护（防扫描 / 探测）
# ==============================================================================

# 是否启用敏感路径探测防护
ENABLE_SENSITIVE_PATH_GUARD=true

# 额外拦截路径（逗号分隔，可为空）
SENSITIVE_PATH_BLOCK_EXTRA=

# 探测记录保留天数
SENSITIVE_PATH_PROBE_RETENTION_DAYS=90

# 命中计数滑动窗口（秒）
SENSITIVE_PATH_HIT_WINDOW_SECONDS=1800

# 自动封禁阈值：中 / 高 / 危 等级在窗口内命中次数
SENSITIVE_PATH_AUTO_BLOCK_MEDIUM=10
SENSITIVE_PATH_AUTO_BLOCK_HIGH=3
SENSITIVE_PATH_AUTO_BLOCK_CRITICAL=5
# 危等级是否推送告警
SENSITIVE_PATH_ALERT_CRITICAL=true
# 告警防抖秒数（同类型告警最短间隔）
SENSITIVE_PATH_ALERT_DEBOUNCE_SECONDS=300

# ==============================================================================
# 二十二、Facebook 像素（兼容旧 .env；运行时凭证优先短链/斗篷配置）
# ==============================================================================
FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
# Graph API 默认版本号
FACEBOOK_API_VERSION=v23.0

# ==============================================================================
# 二十三、Cap / 扣量故障策略
# ==============================================================================
# Cap 检查异常时是否放行（true=fail-open；未设置时：开发放行、生产拒绝）
CAP_FAIL_OPEN=false

# 扣量异常时是否放行（true=fail-open；未设置时：开发放行、生产拒绝）
DEDUCTION_FAIL_OPEN=false

