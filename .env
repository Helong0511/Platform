# ==============================================================================
# CPL 广告管理平台 - 环境配置文件
# ==============================================================================
# 使用说明：
# 1. 测试环境：复制此文件为 .env，修改为测试配置
# 2. 生产环境：在生产服务器上修改为生产配置
# 3. 不要将 .env 提交到 Git（已加入 .gitignore）
# ==============================================================================

# ==============================================================================
# 一、环境配置
# ==============================================================================
# [必填] 环境类型
# 测试环境：development 或 test
# 生产环境：production 或 prod
PRODUCTION_ENV=production

# 环境名称（用于日志和监控）
# 测试环境：test
# 生产环境：production
ENV_NAME=production

# ==============================================================================
# 二、安全配置
# ==============================================================================
# [必填] JWT 签名密钥
# 测试环境可以使用固定密钥
# 生产环境必须使用强随机密钥（建议 64 字符以上）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=NeofZ7iF8tNW6GzkyMZfsGmitY6r6Gwn6D5BU433Vu9lkFwciS2PApBkPMurQuexc9ZgWUjxQA6ZBHMx_bdvHQ

# ==============================================================================
# 三、JWT 配置
# ==============================================================================
JWT_ALGORITHM=RS256

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=240

# 刷新令牌过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# 是否信任反向代理传入的 X-Forwarded-For / X-Real-IP（生产在 Nginx 后建议 true）
TRUST_PROXY_HEADERS=true

# 仅当请求直接来自这些代理 IP 时才读取上述转发头（逗号分隔）
TRUSTED_PROXY_IPS=127.0.0.1,::1

# RSA 密钥路径
# 测试环境：keys/private_key.pem
# 生产环境：/data/Platform/keys/private_key.pem
RSA_PRIVATE_KEY_PATH=/data/Platform/keys/private_key.pem
RSA_PUBLIC_KEY_PATH=/data/Platform/keys/public_key.pem

# RSA 密钥内容（可选；若设置则优先于文件路径，便于容器/密钥注入）
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# ==============================================================================
# 四、数据库配置（MySQL 8.0）
# ==============================================================================
# [必填] 数据库连接 URI
# 格式：mysql+aiomysql://用户名：密码@主机：端口/数据库名

# 生产环境配置：
DATABASE_URL=mysql+aiomysql://remote:kb7$rL3d8!tQ@127.0.0.1:3306/platform?charset=utf8mb4&collation=utf8mb4_0900_ai_ci

# 连接池配置（每个 worker 进程独立持有）
# 池内常驻连接数
DB_POOL_SIZE=15
# 高峰时可临时多开的溢出连接数（用完会释放）
DB_MAX_OVERFLOW=10
# 连接最长复用秒数，超时后回收重建，避免 MySQL 主动断开陈旧连接（3600=1小时）
DB_POOL_RECYCLE=3600

# ==============================================================================
# 五、Redis 配置
# ==============================================================================
# Windows 本机无 Redis 时可保持 REDIS_HOST=127.0.0.1（与生产一致）：
# 非生产环境代码会自动跳过本机连接并使用内存存储；本机已装 Redis 时设 REDIS_FORCE=true
# 有 Redis 时取消注释下一行：REDIS_HOST=127.0.0.1

# Redis 完整连接 URL（部分模块使用；通常与 HOST/PORT/DB/PASSWORD 二选一或并存）
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 本机已装 Redis，强制走真实 Redis（不内存降级）
REDIS_FORCE=true
# 测试环境密码：CPL_Redis_2026!
# 生产环境密码：CPL_Production_Redis_2026!@#
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10

# ==============================================================================
# 六、CORS 配置
# ==============================================================================
# [必填] 允许的跨域来源

# 测试环境：
# BACKEND_CORS_ORIGINS=http://localhost:3310,https://btfrx.online,https://www.btfrx.online,https://client.btfrx.online

# 测试环境：
BACKEND_CORS_ORIGINS=https://btfrx.online,https://www.btfrx.online,https://client.btfrx.online

# ==============================================================================
# 七、管理员账户配置
# ==============================================================================
FIRST_SUPERUSER=admin
# 测试环境密码：Admin123!
# 生产环境密码：使用强密码
FIRST_SUPERUSER_PASSWORD=yinghexinxi123

# ==============================================================================
# 八、API 限流配置
# ==============================================================================
# 测试环境可以放宽限制
# 生产环境建议严格限制
# 未登录普通 API：每分钟每 IP 请求上限
API_RATE_LIMIT=100
# 登录接口：每分钟每 IP 请求上限（防暴力破解）
LOGIN_RATE_LIMIT=10
# 客户开放 API（/client_data、/client_products，签名鉴权）：独立桶，每分钟每 IP 上限
# 翻页拉数场景请求量大，默认高于普通匿名接口
CLIENT_OPEN_API_RATE_LIMIT=2000

# ==============================================================================
# 九、文件上传配置
# ==============================================================================
MAX_UPLOAD_SIZE=10485760

# ==============================================================================
# 十、CSRF 防护配置
# ==============================================================================
# 测试环境可以关闭（方便调试）
# 生产环境必须开启
ENABLE_CSRF=true
CSRF_TOKEN_EXPIRE_SECONDS=3600

# ==============================================================================
# 十一、定时任务配置
# ==============================================================================
MAX_CONCURRENT_SCHEDULED_TASKS=2

# ==============================================================================
# 十二、日志配置（写入分类 + 轮转 + 文件超期清理）
# ==============================================================================
# 说明：
#   - 应用日志目录由 LOG_FILE 的目录部分决定（默认项目根下 logs/）
#   - 分类文件：error.log / warning.log / app.log / access.log / 模块日志等
#   - 本段「文件清理」与下方「十三、审计日志」(DB UserAuditLog) 相互独立
# ------------------------------------------------------------------------------

# 根日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
#   开发常用 INFO 或 DEBUG；生产建议 INFO 或 WARNING
#   注意：即使设为 INFO，默认也不会把全量 INFO 写入 app.log（app.log 仍为 WARNING+）
LOG_LEVEL=INFO

# 主日志路径（主要用于推导日志目录；实际还会写入 error/warning/access 等分类文件）
#   相对路径相对项目根；也可写绝对路径
LOG_FILE=logs/app.log

# 单个日志文件大小上限（字节），超过后按大小轮转生成 .1 / .2 …
#   默认 10485760 = 10MB
LOG_MAX_BYTES=10485760

# 普通分类日志保留的轮转备份份数（如 app.log.1 … app.log.N）
LOG_BACKUP_COUNT=10

# 错误日志 error.log 的轮转备份份数（建议多于普通日志，便于排障）
LOG_ERROR_BACKUP_COUNT=20

# 是否启用 logs/error.log（ERROR 及以上，含无堆栈的 error；排障第一入口）
LOG_ERROR_FILE_ENABLED=true

# 是否启用 logs/warning.log（仅 WARNING，不含 ERROR）
LOG_WARNING_FILE_ENABLED=true

# 是否启用 logs/info.log（仅 INFO；默认关闭，避免生产磁盘暴涨）
#   需要全量 INFO 排查时再临时改为 true
LOG_INFO_FILE_ENABLED=false

# 是否对落盘消息做轻量敏感字段打码（password/token/authorization/secret/api_key 等）
LOG_SENSITIVE_FILTER_ENABLED=true

# 是否启用 logs/tracking.log（追踪点击、短链、斗篷相关模块 INFO+）
LOG_TRACKING_FILE_ENABLED=true

# 是否启用 logs/auth.log（登录/鉴权相关模块 INFO+）
LOG_AUTH_FILE_ENABLED=true

# 生产环境是否全量记录 access.log（默认 false）
#   false：不记「请求开始」；仅记录 4xx/5xx、慢请求、异常；/health 等探针成功请求跳过
#   true：恢复每个请求开始+完成的全量 access（磁盘压力大，仅排障临时开启）
LOG_ACCESS_FULL_IN_PRODUCTION=false

# access 慢请求阈值（秒）；生产降噪模式下超过该耗时也会写入 access.log
LOG_ACCESS_SLOW_SECONDS=3.0

# 进程内异步队列写盘（默认 true）：业务线程只投递，后台线程落盘，降低请求路径磁盘阻塞
#   false：回退为文件 Handler 直接挂在 logger 上（同步写盘，便于极简排查）
#   说明：每个 Gunicorn worker 仍各自一套队列；跨进程安全靠 SafeRotating 轮转锁
#   若启用 PRELOAD_APP=true，gunicorn post_fork 会重建队列（避免 fork 后 listener 线程失效）
LOG_QUEUE_ENABLED=true

# 异步日志队列最大条数（默认 20000）；满则丢弃新记录并累计计数，防止日志风暴撑爆内存
#   设为 0 表示无界（不推荐生产）
LOG_QUEUE_MAXSIZE=20000

# Gunicorn HTTP access 日志开关（默认关闭，避免与应用 access.log 双写撑爆磁盘）
#   需要对照 Nginx/Gunicorn 原始 access 时再设 true
GUNICORN_ACCESSLOG_ENABLED=false

# ------------------------------------------------------------------------------
# 文件日志超期清理（定时任务「清理文件日志」，默认每天 03:30）
#   只处理 logs/ 白名单轮转备份与 archive 内 gzip；正在写入的活跃 *.log 主文件不会删除
#   与 AUDIT_LOG_*（数据库审计表清理）不是同一套机制
# ------------------------------------------------------------------------------

# 总开关：是否执行文件日志清理任务
LOG_FILE_CLEANUP_ENABLED=true

# 超期备份是否先 gzip 归档到 LOG_ARCHIVE_DIR（false 则直接删除超期备份）
#   access/info 等类别即使为 true 也可能按策略直接删除（省盘）
LOG_FILE_ARCHIVE=true

# 归档目录（相对项目根或绝对路径）；通常为 logs/archive/<类别>/xxx.gz
LOG_ARCHIVE_DIR=logs/archive

# —— 各级别/类别「轮转备份文件」保留天数（按文件 mtime）——
# 错误备份 error.log.*
LOG_RETENTION_ERROR_DAYS=90
# 警告备份 warning.log.*
LOG_RETENTION_WARNING_DAYS=30
# 应用/模块备份：app/scheduler/telegram/postback 等
LOG_RETENTION_APP_DAYS=14
# 访问日志备份 access.log.*（量大，默认较短；通常直接删不归档）
LOG_RETENTION_ACCESS_DAYS=7
# info.log.* / debug.log.* 备份
LOG_RETENTION_INFO_DAYS=3
# gunicorn_*.log 溢出轮转产生的备份
LOG_RETENTION_GUNICORN_DAYS=14
# logs/ 下无法识别的杂文件（孤儿）保留天数，超期删除
LOG_RETENTION_ORPHAN_DAYS=7

# archive 内 gzip 保留天数（error 类别用此值；其它类别上限约 60 天）
LOG_ARCHIVE_RETENTION_DAYS=180

# —— 磁盘守卫（按 logs 目录总用量，单位 MB）——
# 达到软限制：打 WARNING 告警，不强制删
LOG_DISK_SOFT_LIMIT_MB=2048
# 达到硬限制：紧急删除最旧的非 error 备份/归档，尽量压回约 85% 硬限制以下
LOG_DISK_HARD_LIMIT_MB=4096
# 紧急清理时，近期 error 相关文件仍保留的天数（超过后才允许被紧急删）
LOG_DISK_EMERGENCY_KEEP_ERROR_DAYS=30
# 磁盘软/硬限制是否推送管理员 Telegram（需 TELEGRAM_ENABLE 且配置了 TELEGRAM_ADMIN）
LOG_DISK_TELEGRAM_NOTIFY=true
# 同类磁盘告警防抖秒数（避免清理任务反复刷屏；默认 1 小时）
#   说明：当前防抖为进程内时间戳；多 worker / 多入口仍可能各推一次
LOG_DISK_TELEGRAM_DEBOUNCE_SECONDS=3600
# 监控接口缓存日志目录用量的秒数（避免每次 /metrics 全量扫描）
LOG_DISK_STATS_CACHE_SECONDS=30
# 监控页「立即清理文件日志」冷却秒数（防连点重复扫盘；默认 60）
#   优先 Redis SET NX 跨进程；Redis 不可用时回退为本进程冷却
LOG_MANUAL_CLEANUP_COOLDOWN_SECONDS=60

# ==============================================================================
# 十三、审计日志配置
# ==============================================================================
AUDIT_LOG_RETENTION_DAYS=10
AUDIT_LOG_ARCHIVE=true

# ==============================================================================
# 十四、时区配置
# ==============================================================================
TIMEZONE=Asia/Shanghai

# ==============================================================================
# 十五、Telegram Bot 配置
# ==============================================================================
TELEGRAM_ENABLE=true

TELEGRAM_RUNTIME_ERROR_NOTIFY=true  

TELEGRAM_RUNTIME_ERROR_DEBOUNCE_SECONDS=300 # 同错误防抖秒数

