FLYMOBI_API_FETCH_DAILY=false

# ==============================================================================
# 二十一、敏感路径防护（防扫描 / 探测）
# ==============================================================================

# 是否启用敏感路径探测防护
ENABLE_SENSITIVE_PATH_GUARD=true

# 额外拦截路径（逗号分隔，可为空）
SENSITIVE_PATH_BLOCK_EXTRA=

# 探测记录保留天数
SENSITIVE_PATH_PROBE_RETENTION_DAYS=90

# 命中计数滑动窗口（秒）
SENSITIVE_PATH_HIT_WINDOW_SECONDS=1800

# 自动封禁阈值：中 / 高 / 危 等级在窗口内命中次数
SENSITIVE_PATH_AUTO_BLOCK_MEDIUM=10
SENSITIVE_PATH_AUTO_BLOCK_HIGH=3
SENSITIVE_PATH_AUTO_BLOCK_CRITICAL=5
# 危等级是否推送告警
SENSITIVE_PATH_ALERT_CRITICAL=true
# 告警防抖秒数（同类型告警最短间隔）
SENSITIVE_PATH_ALERT_DEBOUNCE_SECONDS=300

# ==============================================================================
# 二十二、Facebook 像素（兼容旧 .env；运行时凭证优先短链/斗篷配置）
# ==============================================================================
FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
# Graph API 默认版本号
FACEBOOK_API_VERSION=v23.0

# ==============================================================================
# 二十三、Cap / 扣量故障策略
# ==============================================================================
# Cap 检查异常时是否放行（true=fail-open；未设置时：开发放行、生产拒绝）
CAP_FAIL_OPEN=false

# 扣量异常时是否放行（true=fail-open；未设置时：开发放行、生产拒绝）
DEDUCTION_FAIL_OPEN=false

