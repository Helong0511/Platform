# ==============================================================================
# CPL 广告管理平台 - 环境配置文件
# ==============================================================================
# 使用说明：
# 1. 测试环境：复制此文件为 .env，修改为测试配置
# 2. 生产环境：在生产服务器上修改为生产配置
# 3. 不要将 .env 提交到 Git（已加入 .gitignore）
# ==============================================================================

# ==============================================================================
# 一、环境配置
# ==============================================================================
# [必填] 环境类型
# 测试环境：development 或 test
# 生产环境：production 或 prod
PRODUCTION_ENV=production

# 环境名称（用于日志和监控）
# 测试环境：test
# 生产环境：production
ENV_NAME=production

# ==============================================================================
# 二、安全配置
# ==============================================================================
# [必填] JWT 签名密钥
# 测试环境可以使用固定密钥
# 生产环境必须使用强随机密钥（建议 64 字符以上）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=NeofZ7iF8tNW6GzkyMZfsGmitY6r6Gwn6D5BU433Vu9lkFwciS2PApBkPMurQuexc9ZgWUjxQA6ZBHMx_bdvHQ

# ==============================================================================
# 三、JWT 配置
# ==============================================================================
JWT_ALGORITHM=RS256

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=240

# 刷新令牌过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# 是否信任反向代理传入的 X-Forwarded-For / X-Real-IP（生产在 Nginx 后建议 true）
TRUST_PROXY_HEADERS=true

# 仅当请求直接来自这些代理 IP 时才读取上述转发头（逗号分隔）
TRUSTED_PROXY_IPS=127.0.0.1,::1

# RSA 密钥路径
# 测试环境：keys/private_key.pem
# 生产环境：/data/Platform/keys/private_key.pem
RSA_PRIVATE_KEY_PATH=/data/Platform/keys/private_key.pem
RSA_PUBLIC_KEY_PATH=/data/Platform/keys/public_key.pem

# RSA 密钥内容（可选；若设置则优先于文件路径，便于容器/密钥注入）
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# ==============================================================================
# 四、数据库配置（MySQL 8.0）
# ==============================================================================
# [必填] 数据库连接 URI
# 格式：mysql+aiomysql://用户名：密码@主机：端口/数据库名

# 生产环境配置：
DATABASE_URL=mysql+aiomysql://remote:kb7$rL3d8!tQ@127.0.0.1:3306/platform?charset=utf8mb4&collation=utf8mb4_0900_ai_ci

# 连接池配置（每个 worker 进程独立持有）
# 池内常驻连接数
DB_POOL_SIZE=15
# 高峰时可临时多开的溢出连接数（用完会释放）
DB_MAX_OVERFLOW=10
# 连接最长复用秒数，超时后回收重建，避免 MySQL 主动断开陈旧连接（3600=1小时）
DB_POOL_RECYCLE=3600

# ==============================================================================
# 五、Redis 配置
# ==============================================================================
# Windows 本机无 Redis 时可保持 REDIS_HOST=127.0.0.1（与生产一致）：
# 非生产环境代码会自动跳过本机连接并使用内存存储；本机已装 Redis 时设 REDIS_FORCE=true
# 有 Redis 时取消注释下一行：REDIS_HOST=127.0.0.1

# Redis 完整连接 URL（部分模块使用；通常与 HOST/PORT/DB/PASSWORD 二选一或并存）
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 本机已装 Redis，强制走真实 Redis（不内存降级）
REDIS_FORCE=true
# 测试环境密码：CPL_Redis_2026!
# 生产环境密码：CPL_Production_Redis_2026!@#
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10

# ==============================================================================
# 六、CORS 配置
# ==============================================================================
# [必填] 允许的跨域来源

# 测试环境：
# BACKEND_CORS_ORIGINS=http://localhost:3310,https://btfrx.online,https://www.btfrx.online,https://client.btfrx.online

# 测试环境：
BACKEND_CORS_ORIGINS=https://btfrx.online,https://www.btfrx.online,https://client.btfrx.online

# ==============================================================================
# 七、管理员账户配置
# ==============================================================================
FIRST_SUPERUSER=admin
# 测试环境密码：Admin123!
# 生产环境密码：使用强密码
FIRST_SUPERUSER_PASSWORD=My@SecurePssw0rd2025!

# ==============================================================================
# 八、API 限流配置
# ==============================================================================
# 测试环境可以放宽限制
# 生产环境建议严格限制
# 未登录普通 API：每分钟每 IP 请求上限
API_RATE_LIMIT=100
# 登录接口：每分钟每 IP 请求上限（防暴力破解）
LOGIN_RATE_LIMIT=10
# 客户开放 API（/client_data、/client_products，签名鉴权）：独立桶，每分钟每 IP 上限
# 翻页拉数场景请求量大，默认高于普通匿名接口
CLIENT_OPEN_API_RATE_LIMIT=2000

# ==============================================================================
# 九、文件上传配置
# ==============================================================================
MAX_UPLOAD_SIZE=10485760

# ==============================================================================
# 十、CSRF 防护配置
# ==============================================================================
# 测试环境可以关闭（方便调试）
# 生产环境必须开启
ENABLE_CSRF=true
CSRF_TOKEN_EXPIRE_SECONDS=3600

# ==============================================================================
# 十一、定时任务配置
# ==============================================================================
MAX_CONCURRENT_SCHEDULED_TASKS=2

# ==============================================================================
# 十二、日志配置
# ==============================================================================
# 测试环境：DEBUG
# 生产环境：WARNING 或 INFO
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ==============================================================================
# 十三、审计日志配置
# ==============================================================================
AUDIT_LOG_RETENTION_DAYS=10
AUDIT_LOG_ARCHIVE=true

# ==============================================================================
# 十四、时区配置
# ==============================================================================
TIMEZONE=Asia/Shanghai

# ==============================================================================
# 十五、Telegram Bot 配置
# ==============================================================================
TELEGRAM_ENABLE=true

TELEGRAM_RUNTIME_ERROR_NOTIFY=true  

TELEGRAM_RUNTIME_ERROR_DEBOUNCE_SECONDS=300 # 同错误防抖秒数

# 测试环境 Bot Token：8263751942:AAEEBJfiwd4mdwWVNuAB3iTm4ThHo2Bxwvw
# 生产环境 Bot Token：8348688058:AAE0CXsgR4iNjzvcPjHOICQp8e3WSKJ5OtQ
TELEGRAM_TOKEN=8348688058:AAE0CXsgR4iNjzvcPjHOICQp8e3WSKJ5OtQ
# Windows 本地开发只通知第一个账号；Linux 生产环境通知两个账号
TELEGRAM_ADMIN_LOCAL=5312177749
TELEGRAM_ADMIN_PRODUCTION=5312177749,7296493069
# 兼容旧版本，环境专用配置缺失时使用
TELEGRAM_ADMIN=5312177749,7296493069

# ==============================================================================
# 十六、Gunicorn 配置
# ==============================================================================
# 测试环境：2 workers
# 生产环境：(2 × CPU 核心数) + 1
WORKERS=3
PRELOAD_APP=false
MEMORY_GB=4

# ==============================================================================
# 十七、调试配置
# ==============================================================================
# 测试环境：true
# 生产环境：false（必须！）
DEBUG=false

# 允许的主机（生产环境必须设置）
# 测试环境：*
# 生产环境：实际域名
ALLOWED_HOSTS=client.btfrx.online,btfrx.online

# ==============================================================================
# 十八、短链接服务配置
# ==============================================================================
ENABLE_SCHEDULER=false

SHORT_LINK_SYNC_MAX_KEYS=300

# ==============================================================================
# 十九、追踪令牌配置
# ==============================================================================
USE_TRACKING_TOKEN=true
AD_TRACKING_MASTER_KEY_HEX=5a7ed770e8fd02c9a10e3c9f8874501231bd3023777b64254fd076785da18f30
TRACKING_TOKEN_MAX_AGE_SECONDS=7776000
TRACKING_TOKEN_MAX_OUTER_CHARS=255

# 是否写入 clicks 表（显式覆盖 USE_TRACKING_TOKEN 默认行为）
# true=强制写库（可与令牌双轨：Postback 解析令牌 + clicks 表留痕）
# false=强制不写库；未设置时 token on 不写库 / token off 写库
PERSIST_CLICKS_TO_DB=true

# ==============================================================================
# 二十、上游广告数据 API（定时任务拉数，勿提交到公开仓库）
# ==============================================================================

# 上游 HTTP 超时与重试（秒 / 次数；适用于 TBSJ、互广等定时拉数）
UPSTREAM_HTTP_TIMEOUT=45
UPSTREAM_HTTP_CONNECT_TIMEOUT=15
UPSTREAM_HTTP_MAX_RETRIES=3

TQT_APP_KEY=07ycrvnf
TQT_API_SECRET=cglnhl8pbg8zl4b9a44c4qofdrb6rwn4

SKYMOBI_API_ID=10177
SKYMOBI_API_KEY=67b7c7fac2154bb8f59546d9b23058c9

HUGUANG_API_KEY=0bb7cedcb40997a5784d1fd38df601e1
HUGUANG_API_DOMAIN=103.146.79.52
HUGUANG_API_USERNAME=yinghe

TBSJ_API_USERNAME=BOFIT1
TBSJ_API_PASSWORD=f8034e342a8e6070aadaee559c3c95eb

# 通百世家 API Base（无尾斜杠）；Token 地址为 {BASE}/token
TBSJ_API_BASE_URL=https://data.tongbaishijia.com/api/thirdservice

ADDERMOBI_API_USERNAME=Leadwin
ADDERMOBI_API_PASSWORD=lw145667


ZHISUO_API_BASE_URL=https://ch.tecnee.xyz
# 可选：JSON 数组批量账号 [{"client_id":"...","api_key":"..."}]；设置后优先于下方单账号变量
ZHISUO_API_ACCOUNTS=

ZHISUO_API_CLIENT_ID=zhisuo24
ZHISUO_API_KEY=913453ad411f016cf4c3899bc1177e9d

ZHISUO_API_CLIENT_ID_2=zhisuo252
ZHISUO_API_KEY_2=7593dee39ca94fc7bc39dea69ccaa7db

ZHISUO_API_CLIENT_ID_3=zhisuo13
ZHISUO_API_KEY_3=765aeeaed711e6809558b1a2ee45ccf0

ZHISUO_API_CLIENT_ID_4=KE11
ZHISUO_API_KEY_4=cded7587a3b1aad269b9c9f5248f8b7e

# zhisuo 拉数全局默认（未单独配置的账号使用）
# 日报 /api/channeldaily | 国家 /api/channelcountry | 广告单元 /api/channelunit | 交叉 /api/channeldata
ZHISUO_API_FETCH_UNIT=false
ZHISUO_API_FETCH_COUNTRY=false
ZHISUO_API_FETCH_DATA=true

# 全局日报兜底拉取（unit/country/data 均无该产品+日时才用日报补）
ZHISUO_API_FETCH_DAILY_FALLBACK=false

